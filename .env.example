# Copy to .env (git-ignored) and adjust. Contains NO credentials:
# AWS credentials come from `aws configure` / your profile / an IAM role.

# Pipeline
PIPELINE_DATA_DIR=./data
MIN_ACCURACY=0.90
RANDOM_STATE=42

# Deployment target: "local" (no AWS needed) or "aws" (real AWS or LocalStack)
DEPLOY_MODE=local
MODEL_BUCKET=dam405-wine-models-dev
LAMBDA_FUNCTION_NAME=wine-inference-dev
AWS_DEFAULT_REGION=us-east-1
# Uncomment to target LocalStack instead of real AWS
# AWS_ENDPOINT_URL=http://localhost:4566

# LocalStack auth token (free Hobby account) - keep it here, never in code
# LOCALSTACK_AUTH_TOKEN=
